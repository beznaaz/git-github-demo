# Mission 2 : profils et index. Base Redis du quiz uniquement.
DEL plateforme:quiz:joueurs ville:Rabat:joueurs ville:Casablanca:joueurs ville:Fes:joueurs ville:Tanger:joueurs ville:Marrakech:joueurs
DEL file:duels:attente classement:general:points plateforme:quiz:parties badge:premiere-victoire:joueurs badge:rapide:joueurs badge:invaincu:joueurs
DEL partie:1:fiche partie:2:fiche partie:3:fiche partie:4:fiche partie:5:fiche
HSET joueur:j1:profil pseudo Nour ville Rabat niveau 3 parties 0
SADD plateforme:quiz:joueurs j1
SADD ville:Rabat:joueurs j1
HSET joueur:j2:profil pseudo Ilyas ville Casablanca niveau 5 parties 0
SADD plateforme:quiz:joueurs j2
SADD ville:Casablanca:joueurs j2
HSET joueur:j3:profil pseudo Sara ville Fes niveau 2 parties 0
SADD plateforme:quiz:joueurs j3
SADD ville:Fes:joueurs j3
HSET joueur:j4:profil pseudo Adam ville Rabat niveau 4 parties 0
SADD plateforme:quiz:joueurs j4
SADD ville:Rabat:joueurs j4
HSET joueur:j5:profil pseudo Lina ville Tanger niveau 1 parties 0
